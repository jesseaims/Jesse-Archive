{
  "name": "jesse-archive-tauri",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prebuild": "node scripts/generate-commits.mjs",
    "test:browser": "node --test tests/browser-extension.test.mjs",
    "format": "prettier --write src && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  }
}
