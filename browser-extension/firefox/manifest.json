{
  "manifest_version": 3,
  "name": "JesseArchive · Inserimento rapido",
  "version": "1.1.9",
  "description": "Seleziona dal vault locale gli account per il sito corrente.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Apri JesseArchive per questo campo"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@jessearchive.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
