{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jesse's Archive",
  "version": "1.0.1",
  "identifier": "app.jesse.archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jesse's Archive",
        "width": 1400,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0e1019"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icon.ico"
    ],
    "windows": {
      "wix": {
        "bannerPath": "installer-assets/banner.bmp",
        "dialogImagePath": "installer-assets/dialog.bmp"
      }
    }
  }
}
